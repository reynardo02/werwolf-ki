# Kopiere diese Datei nach .env und trag deine Werte ein. Die .env kommt nie ins Repo.
# Jeder OpenAI-kompatible Anbieter funktioniert. Beispiele:
# Modellnamen ändern sich – prüfe den aktuellen Namen auf der Seite deines Anbieters.

# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=dein-key

# Google Gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_MAX_PRO_MINUTE=14   # kostenloser Tarif: 15 Anfragen pro Minute

# Lokal mit Ollama (kein Key nötig)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_TOOL_CHOICE=auto

# OpenAI mit GPT-6 (z. B. gpt-6.1-sol): Tools beim Nachdenken gibt es nur über /responses
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-6.1-sol
# LLM_SCHNITTSTELLE=responses   # Standard: chat (/chat/completions, versteht fast jeder Anbieter)
# LLM_DENKEN=low   # Nachdenken: minimal, low, medium, high oder standard (= Standard des Modells).
#                  # Bei responses ist low voreingestellt, bei chat wird ohne Angabe nichts geschickt.

# Optional
# LLM_TEMPERATUR=0.9
# LLM_MAX_AUFRUFE=400   # Kostenbremse pro Partie
# LLM_MAX_PRO_MINUTE=0  # Tempolimit, 0 = keins
